FEISHU_APP_SECRET=xxxx
FEISHU_CHAT_ID=oc_xxxx
FEISHU_PROXY=http://127.0.0.1:7892
# 飞书长连接接收（项目本体直连，替代 Hermes）：你的 open_id；机器人 open_id 留空自动查询
